# Modele de /etc/vera/vera.env -- NOMS SEULEMENT. Ne jamais mettre de valeur
# reelle dans ce fichier du depot (audit externe du 19/10/2026, F6).
#
# Installation (en root) :
#   install -d -m 700 /etc/vera
#   cp infra/vera.env.exemple /etc/vera/vera.env
#   chmod 600 /etc/vera/vera.env
#   nano /etc/vera/vera.env        # remplacer les trois CHANGER_MOI
#
# Syntaxe : NOM=valeur, une par ligne, sans guillemets ni `export`.
# `infra/verifier_deploiement.sh` controle que le fichier existe, appartient a
# root, est en mode 600 et porte exactement ces trois noms, sans en afficher
# aucune valeur.
VERA_DB_KEY=CHANGER_MOI
VERA_ADMIN_HASH=CHANGER_MOI
VERA_SECRET_CREATION_COMPTE=CHANGER_MOI
