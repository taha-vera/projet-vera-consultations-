[Unit]
Description=VERA Consultation API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple

# `/root/repo-push`, PAS `/root` (audit cible du 13/10/2026, cf.
# VERA_THREAT_MODEL_COMPLETE.md, « Integrite du deploiement »). Ce fichier
# versionne disait encore `/root` le jour meme ou l'unite REELLE du serveur
# avait deja ete corrigee a la main -- c'est-a-dire que reinstaller l'unite
# depuis ce depot aurait reintroduit le defaut qu'on venait de fermer :
# Python resout `import vera_consultation_api` et `StaticFiles` relativement
# a ce dossier, pas au clone git. Toute reinstallation de cette unite doit
# partir de CE fichier, jamais d'une copie gardee a la main sur le serveur.
WorkingDirectory=/root/repo-push

# SECRETS : DANS UN FICHIER A PART, PAS DANS CETTE UNITE (audit externe du
# 19/10/2026, F6).
#
# Ce fichier a ete versionne pour la premiere fois le 10/09/2026 : jusque-la,
# l'unite qui controle reellement l'execution n'existait que sur le serveur,
# editee a la main. Les trois SECRETS y vivaient en `Environment=` : lisibles en
# clair par `systemctl cat`, `systemctl show` et toute sortie de diagnostic
# collee quelque part -- le chemin exact par lequel des secrets avaient fuite le
# 31/07/2026 (LIMITS.md §12). Ils sont desormais dans /etc/vera/vera.env
# (proprietaire root, mode 600, dossier 700), lu par systemd au demarrage :
# `systemctl cat/show` n'en montre plus que le NOM du fichier.
#
# Modele du fichier : infra/vera.env.exemple (noms seulement, jamais de valeur).
# Creation : voir PROCEDURE_REPRISE_VERA.md, Partie 2, etape 5.
#
#   dans /etc/vera/vera.env (secrets) :
#     VERA_ADMIN_HASH              : empreinte PBKDF2 (format sel_hex$hash_hex),
#                                    jamais le mot de passe en clair.
#     VERA_SECRET_CREATION_COMPTE  : secret de /api/admin/creer_compte_rh.
#                                    Au moins 32 caracteres aleatoires :
#                                    openssl rand -base64 32
#     VERA_DB_KEY                  : chiffre la cle privee RSA au repos.
#                                    64 caracteres hexadecimaux :
#                                    openssl rand -hex 32
#                                    Rotation : cloturer toute consultation
#                                    active d'abord (purge les cles chiffrees),
#                                    puis poser la nouvelle valeur.
#   ci-dessous (pas des secrets) :
#     VERA_DOMAINE                 : le domaine public du service.
#     VERA_ADMIN_USER              : identifiant du compte d'amorcage.
#
# Syntaxe du fichier : NOM=valeur, une par ligne, SANS guillemets ni `export`.
# systemd ne fait aucune expansion de `$` dans un EnvironmentFile : le `$` de
# l'empreinte `sel$hash` est donc litteral, comme il doit l'etre.
EnvironmentFile=/etc/vera/vera.env
Environment="VERA_DOMAINE=https://vera-consultation.fr"
Environment="VERA_ADMIN_USER=CHANGER_MOI"

ExecStart=/root/vera_blind_sig/.venv/bin/python3 -m uvicorn vera_consultation_api:app --no-access-log --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
StandardOutput=append:/root/consultation.log
StandardError=append:/root/consultation.log

# DURCISSEMENT MINIMAL, SANS RISQUE POUR LE SERVICE EN COURS.
#
# NoNewPrivileges n'affecte aucun acces fichier : il empeche seulement le
# processus d'obtenir des privileges supplementaires (setuid, capacites). Sans
# effet fonctionnel connu sur ce service, donc pose sans hesitation.
NoNewPrivileges=true

# CE QUI N'EST PAS FAIT ICI, ET POURQUOI.
#
# ProtectSystem=strict, un utilisateur systeme dedie, et un deplacement de la
# base vers /var/lib/vera ont ete recommandes par un audit externe. Chacun
# change ce que le processus peut lire ou ecrire sur le disque -- un mauvais
# reglage casse le service sans avertissement prealable, sur un systeme qui
# sert des votes. Aucun ne peut etre verifie sans un redemarrage reel et un
# controle post-redemarrage, ce qu'un patch texte ne permet pas de garantir.
#
# A faire deliberement, hors consultation active, avec la sequence :
#   1. ProtectSystem=strict + ReadWritePaths=/root (le service ecrit la base
#      et le journal dans /root ; sans cette ligne, ProtectSystem=strict
#      romprait le demarrage)
#   2. Verifier : systemctl restart, systemctl status, curl sur /vote
#   3. Seulement ensuite, envisager un utilisateur dedie et /var/lib/vera --
#      qui exige de deplacer la base existante, pas seulement de changer un
#      chemin dans ce fichier.

[Install]
WantedBy=multi-user.target
